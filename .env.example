# Public data
FRED_API_KEY=

# Cloud model providers (configure the provider you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# LangSmith tracing (Day 6)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-pm-lab
LANGSMITH_TRACING=false
LANGSMITH_TRACING_MODE=otel

# The identity the stdio MCP server runs as (PM_USER, RISK_USER, ADMIN_USER).
# Fixed when the server starts; requests cannot claim a different one.
AGENTIC_PM_LAB_MCP_IDENTITY=
