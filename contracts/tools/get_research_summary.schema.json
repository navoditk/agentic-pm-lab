{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "get_research_summary contract",
  "type": "object",
  "required": ["input", "output"],
  "properties": {
    "input": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["query", "summary", "mock"],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "mock": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
