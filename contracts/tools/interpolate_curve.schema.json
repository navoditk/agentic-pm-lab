{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "interpolate_curve contract",
  "type": "object",
  "required": ["input", "output"],
  "properties": {
    "input": {
      "type": "object",
      "required": ["tenors_years", "rates_pct", "target_tenors_years"],
      "properties": {
        "tenors_years": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "rates_pct": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "number"}
        },
        "target_tenors_years": {
          "type": "array",
          "items": {"type": "number", "exclusiveMinimum": 0}
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "array",
      "items": {"type": "number"}
    }
  },
  "additionalProperties": false
}
